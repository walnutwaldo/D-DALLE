rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The D-DALLE app does not use the Firestore client SDK; all data access
    // goes through the trusted backend via the Admin SDK, which bypasses these
    // rules. Deny all direct client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
